ADMIN_USER_IDS=1859836370
GROUP_TRIGGER_KEYWORD=/chat
MAX_CONVERSATION_AGE_MINUTES=180
MAX_HISTORY_SIZE=30
STREAM_UPDATE_INTERVAL=1.5
